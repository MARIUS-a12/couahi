APP_NAME=Couahi
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Nom neutre : le cookie est posé sur le domaine de chaque boutique, donc
# visible du client final, à qui « Couahi » doit rester invisible. Ne pas le
# dériver de APP_NAME (voir config/session.php).
SESSION_COOKIE=session
# NE PAS mettre ".localhost" (ou tout domaine parent) ici, même si ça
# semble régler un problème de cookie cross-subdomain. Chaque établissement
# a son propre sous-domaine (chez-awa.*, maquis-du-port.*) : un cookie de
# session partagé entre sous-domaines authentifierait un admin de l'un sur
# le compte de l'autre. Un cookie par sous-domaine (donc SESSION_DOMAIN=null,
# implicite = hôte exact de la requête) est le comportement voulu, pas un bug.
SESSION_DOMAIN=null

# Sanctum en mode SPA (cookies de session, pas de jetons Bearer) : hôtes
# autorisés à recevoir le cookie de session, SANS schéma (hote[:port]).
# Le "*" couvre les sous-domaines d'établissement (chez-awa.localhost:5173,
# maquis-du-port.localhost:5173, ...) : chacun a un cookie distinct, voir la
# remarque sur SESSION_DOMAIN ci-dessus — le wildcard n'y change rien, il
# élargit seulement la liste des hôtes autorisés À RECEVOIR un cookie, pas
# le périmètre d'un cookie donné.
# CORS_ALLOWED_ORIGINS : mêmes hôtes, AVEC schéma (http(s)://hote[:port]) —
# à tenir synchronisé, requis par supports_credentials=true dans
# config/cors.php. À mettre à jour dès que le frontend a un domaine réel.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,localhost:8000,*.localhost:5173,*.localhost:8000,127.0.0.1,127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://*.localhost:5173,http://localhost:8000,http://*.localhost:8000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Disque des photos produits (voir config/medias.php) : "public" en
# développement, sert via storage:link. En production, MEDIAS_DISQUE=s3 avec
# les variables AWS_* ci-dessous bascule vers un stockage objet sans changer
# le code.
MEDIAS_DISQUE=public

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
# Expéditeur des messages de la PLATEFORME aux commerçants. Un futur e-mail
# envoyé au client d'une boutique (confirmation de commande...) devra être
# signé du nom de la boutique, jamais de celui-ci.
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Paiement en ligne CinetPay : false tant que l'intégration n'est pas construite.
# Des identifiants CinetPay enregistrés ne suffisent pas à proposer "Payer maintenant".
CINETPAY_ACTIF=false
